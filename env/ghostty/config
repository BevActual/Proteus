# Proteus Ghostty — minimal; look comes from fastfetch on shell start
# Seeded to ~/.config/ghostty/config by vm/install/config.sh
# (Do not force opacity/blur — leave compositor / user theme alone.)

font-family = DejaVu Sans Mono
font-size = 12

window-padding-x = 14
window-padding-y = 12
confirm-close-surface = false
resize-overlay = never

cursor-style = block
cursor-style-blink = false

copy-on-select = clipboard

keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
