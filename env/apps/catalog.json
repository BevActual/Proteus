{
  "schema": "env/apps/schema.json",
  "version": 1,
  "manifests": [
    {
      "id": "pavucontrol",
      "desktopIds": ["pavucontrol", "org.pulseaudio.pavucontrol"],
      "match": "pavucontrol",
      "requiresAny": ["speaker", "mic", "qs_pipewire"],
      "reason": "Needs audio"
    },
    {
      "id": "nm-connection-editor",
      "desktopIds": ["nm-connection-editor", "nm-connection-editor.desktop"],
      "match": "nm-connection|nmtui",
      "requiresAny": ["wifi", "ethernet"],
      "reason": "Needs network"
    },
    {
      "id": "blueman-manager",
      "desktopIds": ["blueman-manager", "blueman-manager.desktop"],
      "match": "blueman|blueberry",
      "requiresAny": ["bt"],
      "reason": "Needs Bluetooth"
    },
    {
      "id": "virt-manager",
      "desktopIds": ["virt-manager", "virt-manager.desktop"],
      "match": "virt-manager|gnome-boxes",
      "requiresAny": ["libvirt", "containers"],
      "postures": ["desktop", "host"],
      "prefers": ["pointer"],
      "reason": "Needs virtualization"
    },
    {
      "id": "proteus-workloads",
      "desktopIds": ["proteus-workloads", "proteus-workloads.desktop"],
      "match": "proteus-workloads",
      "requiresAny": ["libvirt", "containers"],
      "postures": ["host"],
      "device_classes": ["desktop", "laptop", "server"],
      "prefers": ["pointer"],
      "reason": "Needs virtualization or containers on Host"
    },
    {
      "id": "proteus-vitals-glance",
      "desktopIds": ["proteus-vitals-glance", "proteus-vitals-glance.desktop"],
      "match": "vitals-glance|proteus-vitals",
      "requires": ["vitals"],
      "device_classes": ["watch", "phone"],
      "reason": "Vitals glance is for wearables and phones"
    },
    {
      "id": "steam",
      "desktopIds": ["steam", "steam.desktop"],
      "match": "\\bsteam\\b",
      "requiresAny": ["display"],
      "postures": ["desktop", "console"],
      "prefers": ["gamepad", "pointer"],
      "adapts": {
        "input": ["remote", "gamepad", "pointer", "touch"],
        "nav": ["dense", "sparse"],
        "panes": ["full", "minimal"]
      },
      "reason": "Needs a display — remote via PROTEUS_REMOTE_PROBE stub until Wave B sensor"
    },
    {
      "id": "proteus-settings",
      "desktopIds": ["proteus-settings", "proteus-settings.desktop"],
      "match": "proteus-settings",
      "requiresAny": ["display"],
      "postures": ["desktop", "console", "host"],
      "prefers": ["pointer"],
      "adapts": {
        "input": ["pointer", "touch", "gamepad"],
        "nav": ["dense", "sparse"],
        "panes": ["full", "minimal"]
      },
      "reason": "Needs a display — reads PROTEUS_ADAPT_* at launch (About)"
    },
    {
      "id": "snapshot",
      "desktopIds": ["org.gnome.Snapshot", "snapshot"],
      "match": "gnome-snapshot|org\\.gnome\\.Snapshot",
      "permissions": ["camera"],
      "reason": "Needs camera permission"
    },
    {
      "id": "cheese",
      "desktopIds": ["org.gnome.Cheese", "cheese"],
      "match": "cheese",
      "permissions": ["camera"],
      "reason": "Needs camera permission"
    },
    {
      "id": "obs",
      "desktopIds": ["com.obsproject.Studio", "obs", "obs-studio"],
      "match": "obs-studio|com\\.obsproject",
      "requiresAny": ["speaker", "mic", "qs_pipewire"],
      "permissions": ["microphone", "screen"],
      "reason": "Needs audio / screen capture permission"
    }
  ]
}
