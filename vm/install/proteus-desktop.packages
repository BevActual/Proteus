# Proteus desktop kit — default apps for a livable dogfood session.
# Installed by desktop.sh when PROTEUS_INSTALL_DESKTOP=1 (default) or
# skipped with PROTEUS_INSTALL_DESKTOP=0.
# Keep out of proteus-base.packages.

# Browser (default)
chromium

# Files (placeholder until a first-party Proteus files app)
nautilus
gvfs
gvfs-mtp
gvfs-smb
tumbler
ffmpegthumbnailer

# Viewers
imv
mpv
evince

# Small utilities (interim Calculator until a Proteus calc app; Spotlight still does quick math)
gnome-calculator
mousepad
file-roller
unzip
satty

# LAN AirDrop-style share — Settings → Network → LocalSend · Control Center tile.
# Prefer AUR prebuilt (localsend-bin) over source localsend (Flutter/fvm make-deps)
# or Flatpak. Omarchy/official mirrors may ship `localsend` — desktop.sh treats
# either package name as satisfying this seat.
localsend-bin
