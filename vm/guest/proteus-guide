#!/usr/bin/env python3
"""proteus-guide — listen-only gamepad → Proteus chrome IPC.

Guide (BTN_MODE): single/double from settings (nav | cc | off) in console;
on desktop, single/double open Control Center when not off.

Face buttons / D-pad / HAT: only while chrome reports padWanted (nav, switcher,
CC, Beacon, lock). Never grabs the device — games keep the pad when chrome is down.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

try:
    import evdev
    from evdev import ecodes
except ImportError:
    print("proteus-guide: python-evdev not installed", file=sys.stderr)
    sys.exit(1)

DOUBLE_MS = 350
LONG_MS = 800
SETTINGS = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "proteus" / "settings.json"
POSTURE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "proteus" / "posture"
ROOT = Path(os.environ.get("PROTEUS_ROOT", "/mnt/proteus"))
SHELL = ROOT / "shell"
# Gamescope-owned console session (proteus-console-gs-session exports this):
# chrome IPC targets the Home profile; Guide single = focus-flip via router.
SESSION_MODE = os.environ.get("PROTEUS_CONSOLE_SESSION") == "gamescope"
HOME_PROFILE = ROOT / "shell" / "console-home"

# Held D-pad: wait REPEAT_DELAY_MS before auto-repeat starts, then fire every
# REPEAT_MS. Without the initial delay a normal press (~250 ms) fired twice.
REPEAT_DELAY_MS = 450
REPEAT_MS = 170
# Same button within this window = duplicate report (BTN_DPAD_* + ABS_HAT
# for one press, or a Steam virtual pad mirroring the physical device).
DEDUPE_MS = 60


def log(msg: str) -> None:
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S')} proteus-guide: {msg}\n"
    try:
        p = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "proteus-guide.log"
        p.open("a").write(line)
    except OSError:
        pass


def read_posture() -> str:
    try:
        return POSTURE.read_text(encoding="utf-8").strip() or "desktop"
    except OSError:
        return "desktop"


def read_guide_actions() -> tuple[str, str]:
    single, double = "nav", "cc"
    try:
        data = json.loads(SETTINGS.read_text(encoding="utf-8"))
        single = str(data.get("gamepadsGuideSingle", single))
        double = str(data.get("gamepadsGuideDouble", double))
    except (OSError, json.JSONDecodeError):
        pass

    def norm(v: str) -> str:
        v = (v or "").strip().lower()
        if v in ("nav", "navigation", "switcher", "home"):
            return "nav"
        if v in ("cc", "controlcenter", "control-center", "settings"):
            return "cc"
        if v in ("off", "none", "disabled"):
            return "off"
        return "nav" if v == "" else v

    return norm(single), norm(double)


def shell_path() -> str:
    if SESSION_MODE:
        return str(HOME_PROFILE.resolve() if HOME_PROFILE.exists() else HOME_PROFILE)
    return str(SHELL.resolve() if SHELL.exists() else SHELL)


def qs_call(*args: str) -> str:
    cmd = ["qs", "-p", shell_path(), "ipc", "call", *args]
    try:
        r = subprocess.run(cmd, check=False, capture_output=True, timeout=3, text=True)
        return (r.stdout or "").strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"ipc failed: {e}")
        return ""


def focus_router(cmd: str) -> None:
    router = ROOT / "shell" / "scripts" / "proteus-console-focus"
    argv = [str(router) if router.exists() else "proteus-console-focus", cmd]
    try:
        subprocess.run(argv, check=False, capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"focus router failed: {e}")


def ipc_guide(action: str) -> None:
    posture = read_posture()
    if posture == "console":
        if SESSION_MODE and action == "nav":
            # Gamescope session: Guide single = focus-flip Home ↔ title
            focus_router("toggle")
            return
        target = {"nav": "consoleNav", "cc": "consoleCC"}.get(action)
        if target:
            qs_call("chrome", target)
        return
    # Desktop: Guide opens Control Center
    if action in ("nav", "cc"):
        qs_call("chrome", "controlCenter")


def ipc_pad(button: str) -> None:
    qs_call("chrome", "pad", button)


def chrome_pad_wanted() -> bool:
    raw = qs_call("chrome", "state")
    if not raw:
        return False
    try:
        # Strip ANSI / noise — take last JSON object-looking line
        line = raw.strip().splitlines()[-1]
        # Find JSON blob
        i = line.find("{")
        if i < 0:
            return False
        data = json.loads(line[i:])
    except (json.JSONDecodeError, IndexError):
        return False
    if data.get("padWanted") is True:
        return True
    if data.get("locked"):
        return True
    if data.get("controlCenter") or data.get("launcher"):
        return True
    if data.get("nav") or data.get("switcher"):
        return True
    return False


def is_gamepad(dev: evdev.InputDevice) -> bool:
    caps = dev.capabilities().get(ecodes.EV_KEY, [])
    markers = {
        ecodes.BTN_MODE,
        ecodes.BTN_GAMEPAD,
        getattr(ecodes, "BTN_SOUTH", 0x130),
        getattr(ecodes, "BTN_START", 0x13b),
    }
    return bool(markers.intersection(caps))


def open_gamepads() -> list[evdev.InputDevice]:
    out: list[evdev.InputDevice] = []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
        except OSError:
            continue
        if is_gamepad(d):
            out.append(d)
    return out


BTN_MAP = {
    getattr(ecodes, "BTN_SOUTH", 0x130): "a",
    getattr(ecodes, "BTN_EAST", 0x131): "b",
    getattr(ecodes, "BTN_NORTH", 0x133): "x",
    getattr(ecodes, "BTN_WEST", 0x134): "y",
    getattr(ecodes, "BTN_START", 0x13b): "start",
    getattr(ecodes, "BTN_SELECT", 0x13a): "select",
    getattr(ecodes, "BTN_TL", 0x136): "lb",   # left bumper — console tab cycle
    getattr(ecodes, "BTN_TR", 0x137): "rb",   # right bumper
    getattr(ecodes, "BTN_DPAD_UP", 0x220): "up",
    getattr(ecodes, "BTN_DPAD_DOWN", 0x221): "down",
    getattr(ecodes, "BTN_DPAD_LEFT", 0x222): "left",
    getattr(ecodes, "BTN_DPAD_RIGHT", 0x223): "right",
}

HAT_X = getattr(ecodes, "ABS_HAT0X", 0x10)
HAT_Y = getattr(ecodes, "ABS_HAT0Y", 0x11)


def acquire_single_instance_lock():
    """One guide per session — a second listener doubles every pad press.

    Retries briefly: posture flips pkill the old guide right before starting
    the new one, and the old process may need a moment to release the lock.
    """
    import fcntl

    path = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "proteus-guide.lock"
    for _ in range(20):
        try:
            fh = path.open("w")
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fh.write(str(os.getpid()))
            fh.flush()
            return fh  # keep open — lock lives with the fd
        except OSError:
            time.sleep(0.1)
    return None


def main() -> int:
    lock = acquire_single_instance_lock()
    if lock is None:
        log("another proteus-guide holds the lock — exiting (no double inputs)")
        return 0
    devices = open_gamepads()
    log(f"watching {len(devices)} gamepad(s) posture={read_posture()}")

    pending_press = 0.0
    mode_down_at = 0.0
    mode_long_fired = False
    single_action, double_action = read_guide_actions()
    last_settings = time.time()
    last_pad_wanted_poll = 0.0
    pad_wanted = False
    # Held direction for repeat: dir -> (pressed_at, last_fire)
    held_dir: dict[str, tuple[float, float]] = {}
    hat_x = 0
    hat_y = 0
    # Last press-edge send per button (dedupe duplicate reports)
    last_sent: dict[str, float] = {}

    def send_pad(btn: str, at: float) -> bool:
        if at - last_sent.get(btn, 0.0) < DEDUPE_MS / 1000:
            return False
        last_sent[btn] = at
        ipc_pad(btn)
        return True

    from select import select

    while True:
        now = time.time()

        if now - last_settings > 2.0:
            single_action, double_action = read_guide_actions()
            last_settings = now
            devices = open_gamepads() or devices

        if now - last_pad_wanted_poll > 0.35:
            pad_wanted = chrome_pad_wanted()
            last_pad_wanted_poll = now

        if not devices:
            time.sleep(1.0)
            devices = open_gamepads()
            continue

        r, _, _ = select(devices, [], [], 0.04)
        now = time.time()

        # Guide long-hold → Start (exit confirm on console)
        if mode_down_at and not mode_long_fired and (now - mode_down_at) * 1000 >= LONG_MS:
            mode_long_fired = True
            pending_press = 0.0
            if read_posture() == "console":
                ipc_pad("start")

        # Guide single resolve
        if pending_press and (now - pending_press) * 1000 >= DOUBLE_MS:
            if single_action != "off":
                ipc_guide(single_action)
            pending_press = 0.0

        # D-pad repeat while held and pad wanted: initial delay, then interval
        if pad_wanted:
            for d, (pressed_at, last_fire) in list(held_dir.items()):
                if (now - pressed_at) * 1000 < REPEAT_DELAY_MS:
                    continue
                if (now - last_fire) * 1000 >= REPEAT_MS:
                    last_sent[d] = now
                    ipc_pad(d)
                    held_dir[d] = (pressed_at, now)

        for dev in r:
            try:
                for event in dev.read():
                    if event.type == ecodes.EV_KEY:
                        if event.code == ecodes.BTN_MODE:
                            if event.value == 1:
                                mode_down_at = now
                                mode_long_fired = False
                                if pending_press and (now - pending_press) * 1000 < DOUBLE_MS:
                                    pending_press = 0.0
                                    mode_down_at = 0.0
                                    if double_action != "off":
                                        ipc_guide(double_action)
                                else:
                                    pending_press = now
                            elif event.value == 0:
                                mode_down_at = 0.0
                                if mode_long_fired:
                                    mode_long_fired = False
                                    pending_press = 0.0
                            continue

                        btn = BTN_MAP.get(event.code)
                        if not btn:
                            continue
                        if event.value == 1 and pad_wanted:
                            fired = send_pad(btn, now)
                            if btn in ("up", "down", "left", "right"):
                                if fired:
                                    held_dir[btn] = (now, now)
                                else:
                                    # Duplicate report — keep the existing hold
                                    held_dir.setdefault(btn, (now, now))
                        elif event.value == 0 and btn in held_dir:
                            del held_dir[btn]

                    elif event.type == ecodes.EV_ABS and pad_wanted:

                        def hat_dir(pressed: str, released: str) -> None:
                            held_dir.pop(released, None)
                            if send_pad(pressed, now):
                                held_dir[pressed] = (now, now)
                            else:
                                # Duplicate of a BTN_DPAD press — keep the hold
                                held_dir.setdefault(pressed, (now, now))

                        if event.code == HAT_X:
                            hat_x = event.value
                            if hat_x == 0:
                                for d in ("left", "right"):
                                    held_dir.pop(d, None)
                            elif hat_x < 0:
                                hat_dir("left", "right")
                            else:
                                hat_dir("right", "left")
                        elif event.code == HAT_Y:
                            hat_y = event.value
                            if hat_y == 0:
                                for d in ("up", "down"):
                                    held_dir.pop(d, None)
                            elif hat_y < 0:
                                hat_dir("up", "down")
                            else:
                                hat_dir("down", "up")
            except OSError:
                try:
                    devices.remove(dev)
                except ValueError:
                    pass


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
