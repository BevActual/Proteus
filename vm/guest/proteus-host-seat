#!/usr/bin/env bash
# proteus-host-seat — attach/detach host ops chrome without leaving host posture.
# Usage: proteus-host-seat attach|detach|status
# Fact: ~/.config/proteus/host-chrome (none|full). Posture stays host.
# Local seat stand-in for later session.graphical_remote attach.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${PROTEUS_ROOT:-}" && -d "${PROTEUS_ROOT}/shell" ]]; then
  ROOT="${PROTEUS_ROOT}"
elif [[ -d "${HERE}/../../shell" && -d "${HERE}/../../env" ]]; then
  ROOT="$(cd "${HERE}/../.." && pwd)"
elif [[ -d /mnt/proteus/shell ]]; then
  ROOT=/mnt/proteus
else
  ROOT="${PROTEUS_ROOT:-/mnt/proteus}"
fi
export PROTEUS_ROOT="${ROOT}"

CMD="${1:-}"
[[ -n "${CMD}" ]] || {
  echo "usage: $0 attach|detach|status" >&2
  exit 2
}

POSTURE=""
if [[ -x "${HERE}/proteus-posture" ]]; then
  POSTURE="${HERE}/proteus-posture"
elif [[ -x "${ROOT}/vm/guest/proteus-posture" ]]; then
  POSTURE="${ROOT}/vm/guest/proteus-posture"
elif command -v proteus-posture >/dev/null 2>&1; then
  POSTURE="$(command -v proteus-posture)"
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus"
FACT_POSTURE="${CONFIG_DIR}/posture"
FACT_CHROME="${CONFIG_DIR}/host-chrome"

read_posture() {
  local v="desktop"
  if [[ -f "${FACT_POSTURE}" ]]; then
    v="$(tr -d '[:space:]' <"${FACT_POSTURE}" || true)"
  fi
  case "${v}" in
    console|host) echo "${v}" ;;
    *) echo desktop ;;
  esac
}

read_chrome() {
  local v="full"
  if [[ -f "${FACT_CHROME}" ]]; then
    v="$(tr -d '[:space:]' <"${FACT_CHROME}" || true)"
  fi
  case "${v}" in
    none|off|0|headless) echo none ;;
    *) echo full ;;
  esac
}

case "${CMD}" in
  status)
    echo "posture=$(read_posture)"
    echo "host-chrome=$(read_chrome)"
    ;;
  attach)
    [[ -n "${POSTURE}" ]] || {
      echo "proteus-host-seat: proteus-posture not found" >&2
      exit 1
    }
    # Ensure host posture + ops chrome (sticky local seat).
    exec env PROTEUS_ROOT="${ROOT}" "${POSTURE}" host --chrome
    ;;
  detach)
    [[ -n "${POSTURE}" ]] || {
      echo "proteus-host-seat: proteus-posture not found" >&2
      exit 1
    }
    # Stay in host; stop QS / wallpaper (headless seat).
    exec env PROTEUS_ROOT="${ROOT}" "${POSTURE}" host --headless
    ;;
  *)
    echo "usage: $0 attach|detach|status" >&2
    exit 2
    ;;
esac
