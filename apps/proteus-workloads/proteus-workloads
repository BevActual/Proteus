#!/usr/bin/env bash
# Launch the Proteus Workloads app (VM/container ops · one-click apps · shares).
# Single-instance: if already running, raise it instead of spawning another QS.
# Usage: proteus-workloads [--tab workloads|apps|shares]
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export QS_ICON_THEME="${QS_ICON_THEME:-Papirus-Dark}"

TAB=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tab) TAB="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done

ipc() {
  if command -v qs >/dev/null 2>&1; then
    qs -p "${DIR}" ipc call "$@"
  else
    quickshell -p "${DIR}" ipc call "$@"
  fi
}

if ipc app state >/dev/null 2>&1; then
  if [[ -n "${TAB}" ]]; then
    ipc app openTab "${TAB}" >/dev/null 2>&1 || true
  fi
  ipc app raise >/dev/null 2>&1 || true
  exit 0
fi

PROTEUS_WORKLOADS_TAB="${TAB}" exec quickshell -n -p "${DIR}"
