# Proteus dogfood overlay — session base (Arch official repos only).
# One package per line; comments and blanks ignored.
# Thin: smithay session + owned chrome. Desktop apps → proteus-desktop.packages

# Compositor / session — Hyprland purged; proteus-compositor is the engine.
# Shipping portal-wlr for Screenshot/Screencast.
xdg-desktop-portal-wlr
xdg-desktop-portal
xdg-desktop-portal-gtk
# Retired with Hyprland:
# hyprland
# hypridle
# xdg-desktop-portal-hyprland
xdg-utils
# ~/Downloads, ~/Pictures, … — Chromium/Nautilus expect these
xdg-user-dirs
seatd
polkit
# GUI auth prompts for pkexec (proteus-pkg / proteus-logind / timedatectl …)
hyprpolkitagent
greetd
greetd-tuigreet

# Shell chrome — iced proteus-shell (no Quickshell / Qt chrome stack).

# Terminal + clipboard + screenshots
ghostty
wl-clipboard
cliphist
grim
slurp
libnotify
fuzzel
mesa
# vulkan-virtio lives in hardware/virt.sh (VM only)

# Fonts / icons
ttf-dejavu
noto-fonts
noto-fonts-emoji
papirus-icon-theme

# Audio / media keys
pipewire
pipewire-pulse
wireplumber
pipewire-alsa
pipewire-jack
playerctl

# Laptop / power / brightness (no-op harmlessly on desktop/VM)
brightnessctl
power-profiles-daemon
# Battery + charge thresholds — Power.qml / Settings → Power read UPower.
# The VM has no battery so this went unnoticed; bare metal needs the daemon.
upower

# Hardware truth — Wave A probe + install/hardware/* detect via lspci/lsusb.
# Both are usually present after pacstrap; --needed makes this a no-op then.
pciutils
usbutils
# Intel/AMD DSP audio firmware. Required for speakers/mic on most modern
# laptops; harmless on desktops and VMs.
sof-firmware
# Firmware update path (Settings → About escape; real hardware only)
fwupd

# Software → Flathub pane + install/machine/ensure-flathub.sh. Referenced throughout
# the shell but historically never installed — the pane just showed its
# install-honesty state forever.
flatpak

# Network → Diagnostics: ping (inetutils) + dig (bind). `ss` comes from
# iproute2 in base.
inetutils
bind
# Settings → Network → Tailscale leaf
tailscale
# man escapes from Settings / terminal
man-db

# Network / Bluetooth (Settings owns UX; hide *-manager .desktop via hide-system-apps.sh)
networkmanager
# OpenVPN plugin for Settings → Network → VPN .ovpn import (nmcli type openvpn)
networkmanager-openvpn
openvpn
nm-connection-editor
bluez
bluez-utils
blueman

# Terminal open: fastfetch + DNA helix (Ghostty)
fastfetch
