#!/usr/bin/env bash
# System session wrapper installed to /usr/local/bin/proteus-session
#
# Contract (Session start hygiene #1167 · Phase 3 engine switch):
#   - Best-effort mount /mnt/proteus when that is the product root
#   - Export PROTEUS_SURFACE, PROTEUS_ROOT, QS_ICON_THEME, PATH for chrome/scripts
#   - ENGINE SWITCH — the only place a session compositor is chosen:
#       posture console + session Fact `session` + usable Gamescope
#         → proteus-console-gs-session (Gamescope owns the session)
#       everything else → start-hyprland (watchdog) / bare Hyprland
#   - Gamescope fast-fail degrades the session Fact to `seat` and falls back
#     to Hyprland in the SAME login — a bad console Fact can never loop the
#     greeter or lock the user out of a session
#   - Never exec-once a terminal from this wrapper (Dock / Super+Return only)
set -euo pipefail

if ! mountpoint -q /mnt/proteus 2>/dev/null; then
  mount /mnt/proteus 2>/dev/null || true
fi

export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland

# Install root — greetd starts this wrapper with a clean environment, so
# PROTEUS_ROOT is never inherited at login. Resolve in order and fail soft:
#   1. inherited env (dev / nested / SSH automation)
#   2. ~/.config/proteus/root Fact (written by install/config.sh)
#   3. self-locate — /usr/local/bin helpers are symlinks into the live tree
#   4. /mnt/proteus (VM 9p share)
# A stale Fact must never strand the session: each candidate is validated by
# the presence of <root>/shell before it is accepted.
_proteus_root_valid() { [[ -n "${1:-}" && -d "${1}/shell" ]]; }

_proteus_resolve_root() {
  local cand fact self

  _proteus_root_valid "${PROTEUS_ROOT:-}" && { printf '%s' "${PROTEUS_ROOT}"; return 0; }

  fact="${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/proteus/root"
  if [[ -r "${fact}" ]]; then
    cand="$(tr -d '[:space:]' <"${fact}" 2>/dev/null || true)"
    _proteus_root_valid "${cand}" && { printf '%s' "${cand}"; return 0; }
  fi

  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  if [[ -n "${self}" ]]; then
    cand="$(cd "$(dirname "${self}")/../.." 2>/dev/null && pwd || true)"
    _proteus_root_valid "${cand}" && { printf '%s' "${cand}"; return 0; }
  fi

  printf '%s' /mnt/proteus
}

PROTEUS_ROOT="$(_proteus_resolve_root)"
export PROTEUS_ROOT
if ! _proteus_root_valid "${PROTEUS_ROOT}"; then
  echo "proteus-session: WARN no Proteus tree at ${PROTEUS_ROOT} — chrome will not start" >&2
  echo "proteus-session:      fix: write the root to ~/.config/proteus/root, or re-run install/bootstrap.sh" >&2
fi
# Hard-switch Fact — when PROTEUS_SURFACE unset, honour ~/.config/proteus/posture
if [[ -z "${PROTEUS_SURFACE:-}" ]]; then
  _posture_file="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus/posture"
  if [[ -f "${_posture_file}" ]]; then
    PROTEUS_SURFACE="$(tr -d '[:space:]' <"${_posture_file}" || true)"
  fi
fi
case "${PROTEUS_SURFACE:-}" in
  desktop|console|couch|phone|vr|watch) ;;
  *) PROTEUS_SURFACE=desktop ;;
esac
[[ "${PROTEUS_SURFACE}" == "couch" ]] && PROTEUS_SURFACE=console
export PROTEUS_SURFACE
# Managed-session marker — proteus-posture only terminates sessions started
# through this wrapper (protects nested/dev Hyprland on a workstation).
export PROTEUS_SESSION=1
# Dock / Super+Return → proteus-terminal (Ghostty + VM GL workaround)
export PATH="/usr/local/bin:${PROTEUS_ROOT}/shell/scripts:${PATH}"
# Quickshell chrome icons (Papirus); avoids Adwaita-only / missing glyphs
export QS_ICON_THEME="${QS_ICON_THEME:-Papirus-Dark}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-gtk3}"

# Prefer the watchdog wrapper (crash recovery / safe mode). Bare `Hyprland`
# is only for nested debug (scripts/run-nested.sh) or hosts without the wrapper.
resolve_start_hyprland() {
  if command -v start-hyprland >/dev/null 2>&1; then
    command -v start-hyprland
    return 0
  fi
  local candidate
  for candidate in \
    /usr/local/bin/start-hyprland \
    /usr/bin/start-hyprland \
    "${HOME}/.local/share/omarchy/bin/start-hyprland" \
    /usr/share/omarchy/bin/start-hyprland
  do
    if [[ -x "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

# --- Phase 3 engine switch: Gamescope-owned console session -----------------
console_session_wanted() {
  [[ "${PROTEUS_SURFACE}" == "console" ]] || return 1
  local caps_bin gs_session
  for caps_bin in proteus-console-capabilities \
    "${PROTEUS_ROOT}/shell/scripts/proteus-console-capabilities"; do
    command -v "${caps_bin}" >/dev/null 2>&1 || [[ -x "${caps_bin}" ]] || continue
    if "${caps_bin}" 2>/dev/null | grep -q '"sessionEffective": "session"'; then
      return 0
    fi
    return 1
  done
  return 1
}

degrade_session_fact() {
  local fact="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus/console-session-mode"
  mkdir -p "$(dirname "${fact}")"
  printf 'seat\n' >"${fact}"
  echo "proteus-session: gamescope session failed fast — session Fact degraded to seat" >&2
}

if console_session_wanted; then
  GS_SESSION=""
  for c in proteus-console-gs-session \
    "${PROTEUS_ROOT}/shell/scripts/proteus-console-gs-session"; do
    if command -v "${c}" >/dev/null 2>&1; then
      GS_SESSION="$(command -v "${c}")"
      break
    elif [[ -x "${c}" ]]; then
      GS_SESSION="${c}"
      break
    fi
  done
  if [[ -n "${GS_SESSION}" ]]; then
    _gs_start="$(date +%s)"
    "${GS_SESSION}"
    _gs_rc=$?
    _gs_ran=$(( $(date +%s) - _gs_start ))
    # Normal end (Home exit / posture flip) → end the session (greeter).
    if [[ "${_gs_rc}" -eq 0 || "${_gs_ran}" -ge 10 ]]; then
      exit "${_gs_rc}"
    fi
    # Fast nonzero exit = engine failed to come up. Degrade to the interim
    # seat path and continue into Hyprland in this same login.
    degrade_session_fact
  else
    echo "proteus-session: gamescope session wanted but proteus-console-gs-session missing — falling back to Hyprland" >&2
  fi
fi
# -----------------------------------------------------------------------------

if start_hypr="$(resolve_start_hyprland)"; then
  exec "${start_hypr}"
fi

if command -v Hyprland >/dev/null 2>&1; then
  exec Hyprland
fi

echo "proteus-session: neither start-hyprland nor Hyprland found on PATH" >&2
exit 127
