#!/usr/bin/env bash
# System session wrapper installed to /usr/local/bin/proteus-session
#
# Contract (Hyprland purge · OWNED-STACK):
#   - Best-effort mount /mnt/proteus when that is the product root
#   - Export PROTEUS_SURFACE, PROTEUS_ROOT, QS_ICON_THEME, PATH for chrome/scripts
#   - ENGINE SWITCH — the only place a session compositor is chosen:
#       posture console + session Fact `session` + usable Gamescope
#         → proteus-console-gs-session (Gamescope owns the session)
#       compositor-engine empty|smithay|compositor-next (only shipping engine)
#         + bare seat → proteus-compositor-next --backend drm -c proteus-chrome
#       Fact=hyprland / nested display / missing binary / DRM fail → exit 1
#         (greeter returns; Hyprland is retired — use ./dev/run-nested.sh for nested)
#   - Never exec-once a terminal from this wrapper (Dock / Super+Return only)
set -euo pipefail

if ! mountpoint -q /mnt/proteus 2>/dev/null; then
  mount /mnt/proteus 2>/dev/null || true
fi

export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=wlroots

# Install root — greetd starts this wrapper with a clean environment, so
# PROTEUS_ROOT is never inherited at login. Resolve in order and fail soft:
#   1. inherited env (dev / nested / SSH automation)
#   2. ~/.config/proteus/root Fact (written by install/config.sh)
#   3. self-locate — /usr/local/bin helpers are symlinks into the live tree
#   4. /mnt/proteus (VM 9p share)
# A stale Fact must never strand the session: each candidate is validated by
# the presence of <root>/shell before it is accepted.
_proteus_root_valid() { [[ -n "${1:-}" && -d "${1}/shell" ]]; }

_proteus_resolve_root() {
  local cand fact self

  _proteus_root_valid "${PROTEUS_ROOT:-}" && { printf '%s' "${PROTEUS_ROOT}"; return 0; }

  fact="${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/proteus/root"
  if [[ -r "${fact}" ]]; then
    cand="$(tr -d '[:space:]' <"${fact}" 2>/dev/null || true)"
    _proteus_root_valid "${cand}" && { printf '%s' "${cand}"; return 0; }
  fi

  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  if [[ -n "${self}" ]]; then
    cand="$(cd "$(dirname "${self}")/../.." 2>/dev/null && pwd || true)"
    _proteus_root_valid "${cand}" && { printf '%s' "${cand}"; return 0; }
  fi

  printf '%s' /mnt/proteus
}

PROTEUS_ROOT="$(_proteus_resolve_root)"
export PROTEUS_ROOT
if ! _proteus_root_valid "${PROTEUS_ROOT}"; then
  echo "proteus-session: WARN no Proteus tree at ${PROTEUS_ROOT} — chrome will not start" >&2
  echo "proteus-session:      fix: write the root to ~/.config/proteus/root, or re-run install/bootstrap.sh" >&2
fi
# Hard-switch Fact — when PROTEUS_SURFACE unset, honour ~/.config/proteus/posture
if [[ -z "${PROTEUS_SURFACE:-}" ]]; then
  _posture_file="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus/posture"
  if [[ -f "${_posture_file}" ]]; then
    PROTEUS_SURFACE="$(tr -d '[:space:]' <"${_posture_file}" || true)"
  fi
fi
case "${PROTEUS_SURFACE:-}" in
  desktop|console|couch|phone|vr|watch) ;;
  *) PROTEUS_SURFACE=desktop ;;
esac
[[ "${PROTEUS_SURFACE}" == "couch" ]] && PROTEUS_SURFACE=console
export PROTEUS_SURFACE
# Managed-session marker — proteus-posture only terminates sessions started
# through this wrapper (protects nested/dev on a workstation).
export PROTEUS_SESSION=1
# Dock / Super+Return → proteus-terminal (Ghostty + VM GL workaround)
export PATH="/usr/local/bin:${PROTEUS_ROOT}/shell/scripts:${PATH}"
# Quickshell chrome icons (Papirus); avoids Adwaita-only / missing glyphs
export QS_ICON_THEME="${QS_ICON_THEME:-Papirus-Dark}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-gtk3}"

# --- Phase 3 engine switch: Gamescope-owned console session -----------------
console_session_wanted() {
  [[ "${PROTEUS_SURFACE}" == "console" ]] || return 1
  local caps_bin gs_session
  for caps_bin in proteus-console-capabilities \
    "${PROTEUS_ROOT}/shell/scripts/proteus-console-capabilities"; do
    command -v "${caps_bin}" >/dev/null 2>&1 || [[ -x "${caps_bin}" ]] || continue
    if "${caps_bin}" 2>/dev/null | grep -q '"sessionEffective": "session"'; then
      return 0
    fi
    return 1
  done
  return 1
}

degrade_session_fact() {
  local fact="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus/console-session-mode"
  mkdir -p "$(dirname "${fact}")"
  printf 'seat\n' >"${fact}"
  echo "proteus-session: gamescope session failed fast — session Fact degraded to seat" >&2
}

if console_session_wanted; then
  GS_SESSION=""
  for c in proteus-console-gs-session \
    "${PROTEUS_ROOT}/shell/scripts/proteus-console-gs-session"; do
    if command -v "${c}" >/dev/null 2>&1; then
      GS_SESSION="$(command -v "${c}")"
      break
    elif [[ -x "${c}" ]]; then
      GS_SESSION="${c}"
      break
    fi
  done
  if [[ -n "${GS_SESSION}" ]]; then
    _gs_start="$(date +%s)"
    "${GS_SESSION}"
    _gs_rc=$?
    _gs_ran=$(( $(date +%s) - _gs_start ))
    # Normal end (Home exit / posture flip) → end the session (greeter).
    if [[ "${_gs_rc}" -eq 0 || "${_gs_ran}" -ge 10 ]]; then
      exit "${_gs_rc}"
    fi
    # Fast nonzero exit = engine failed to come up. Degrade Fact and continue
    # into smithay DRM (Hyprland purged — no Hyprland fallthrough).
    degrade_session_fact
  else
    echo "proteus-session: gamescope session wanted but proteus-console-gs-session missing — continuing to smithay DRM" >&2
  fi
fi
# -----------------------------------------------------------------------------

# --- Engine: smithay DRM only (Hyprland purged) -------------------------------
# Empty Fact/env → smithay. Fact=hyprland refused. Nested → exit (use run-nested).
# Missing binary / fast DRM fail → exit 1 (greeter).
resolve_compositor_engine() {
  local raw="" fact
  raw="$(printf '%s' "${PROTEUS_COMPOSITOR_ENGINE:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  if [[ -z "${raw}" ]]; then
    fact="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus/compositor-engine"
    if [[ -r "${fact}" ]]; then
      raw="$(tr '[:upper:]' '[:lower:]' <"${fact}" | tr -d '[:space:]')"
    fi
  fi
  case "${raw}" in
    hyprland|hypr)
      echo "proteus-session: compositor-engine=${raw} refused — Hyprland purged (use smithay)" >&2
      return 1
      ;;
    ""|smithay|compositor-next)
      printf 'smithay'
      return 0
      ;;
    *)
      echo "proteus-session: compositor-engine=${raw} unknown — using smithay" >&2
      printf 'smithay'
      return 0
      ;;
  esac
}

resolve_compositor_next() {
  local candidate
  if command -v proteus-compositor-next >/dev/null 2>&1; then
    command -v proteus-compositor-next
    return 0
  fi
  for candidate in \
    /usr/local/bin/proteus-compositor-next \
    "${PROTEUS_ROOT}/target/release/proteus-compositor-next" \
    "${PROTEUS_ROOT}/target/debug/proteus-compositor-next" \
    "${PROTEUS_ROOT}/compositor-next/target/release/proteus-compositor-next" \
    "${PROTEUS_ROOT}/compositor-next/target/debug/proteus-compositor-next"
  do
    if [[ -x "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

resolve_proteus_chrome() {
  local candidate
  if command -v proteus-chrome >/dev/null 2>&1; then
    command -v proteus-chrome
    return 0
  fi
  for candidate in \
    /usr/local/bin/proteus-chrome \
    "${PROTEUS_ROOT}/shell/scripts/proteus-chrome"
  do
    if [[ -x "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

ENGINE=""
if ! ENGINE="$(resolve_compositor_engine)"; then
  exit 1
fi
[[ "${ENGINE}" == "smithay" ]] || exit 1

# Session login must own the seat — nested dogfood uses ./dev/run-nested.sh.
if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
  echo "proteus-session: nested display present (WAYLAND_DISPLAY/DISPLAY) — refuse (Hyprland purged; use ./dev/run-nested.sh)" >&2
  exit 1
fi

if ! COMP_NEXT="$(resolve_compositor_next)"; then
  echo "proteus-session: proteus-compositor-next missing — refuse (Hyprland purged)" >&2
  exit 1
fi

CHROME_BIN=""
if CHROME_BIN="$(resolve_proteus_chrome)"; then
  :
else
  echo "proteus-session: proteus-chrome missing — launching compositor without -c chrome" >&2
fi

export XDG_CURRENT_DESKTOP=wlroots
export PROTEUS_COMPOSITOR_ENGINE=smithay
_sm_start="$(date +%s)"
set +e
if [[ -n "${CHROME_BIN}" ]]; then
  "${COMP_NEXT}" --backend drm -c "${CHROME_BIN}"
else
  "${COMP_NEXT}" --backend drm
fi
_sm_rc=$?
set -e
_sm_ran=$(( $(date +%s) - _sm_start ))
if [[ "${_sm_rc}" -eq 0 || "${_sm_ran}" -ge 10 ]]; then
  exit "${_sm_rc}"
fi
echo "proteus-session: proteus-compositor-next DRM failed fast (rc=${_sm_rc}) — refuse (Hyprland purged)" >&2
exit 1
