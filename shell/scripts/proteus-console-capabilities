#!/usr/bin/env bash
# proteus-console-capabilities — JSON probe for console seat/session honesty.
# Usage: proteus-console-capabilities
# stdout: one JSON object (vulkan, vulkanHw, gamescope, gamescopeUsable,
#         gameScope, isVm, steam, retroarch, pad, sessionMode,
#         sessionEffective, replacesHyprland)
set -euo pipefail

is_vm() {
  local vendor product
  vendor="$(tr -d '\0' </sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
  product="$(tr -d '\0' </sys/class/dmi/id/product_name 2>/dev/null || true)"
  [[ "${vendor}${product}" =~ [Qq][Ee][Mm][Uu]|[Vv]irtual|[Vv]Mware|[Bb]ox|[Xx]en|[Bb]ochs ]]
}

has_vulkan() {
  # Non-empty physical device list — not merely a Vulkan ICD stub.
  if command -v vulkaninfo >/dev/null 2>&1; then
    local n
    n="$(vulkaninfo --summary 2>/dev/null | grep -cE 'GPU[0-9]+|deviceName' || true)"
    [[ "${n}" -gt 0 ]] && return 0
  fi
  return 1
}

has_hw_vulkan() {
  # A real GPU Vulkan device (discrete or integrated) — llvmpipe (CPU) and
  # Venus (VIRTUAL_GPU) do not count. This is what makes GPU passthrough
  # guests eligible for the Gamescope session while VirGL VMs stay interim.
  command -v vulkaninfo >/dev/null 2>&1 || return 1
  vulkaninfo --summary 2>/dev/null \
    | grep -qE 'deviceType.*(DISCRETE_GPU|INTEGRATED_GPU)'
}

gamescope_bin=0
command -v gamescope >/dev/null 2>&1 && gamescope_bin=1

vulkan=0
has_vulkan && vulkan=1
vulkan_hw=0
has_hw_vulkan && vulkan_hw=1

isvm=0
is_vm && isvm=1

# Usable = binary + a hardware Vulkan device (bare metal or passthrough).
# PROTEUS_FORCE_GAMESCOPE=1 accepts any Vulkan device (e.g. Venus bring-up).
gamescope_usable=0
if [[ "${gamescope_bin}" -eq 1 ]]; then
  if [[ "${vulkan_hw}" -eq 1 ]]; then
    gamescope_usable=1
  elif [[ "${vulkan}" -eq 1 && "${PROTEUS_FORCE_GAMESCOPE:-}" == "1" ]]; then
    gamescope_usable=1
  fi
fi

steam=0
command -v steam >/dev/null 2>&1 && steam=1
retroarch=0
command -v retroarch >/dev/null 2>&1 && retroarch=1

pad=0
if python3 - <<'PY' 2>/dev/null; then
import sys
try:
    import evdev
    from evdev import ecodes
except Exception:
    sys.exit(1)
markers = {ecodes.BTN_MODE, ecodes.BTN_GAMEPAD, getattr(ecodes, "BTN_SOUTH", 0x130)}
for path in evdev.list_devices():
    try:
        d = evdev.InputDevice(path)
        keys = set(d.capabilities().get(ecodes.EV_KEY, []))
        if keys & markers:
            sys.exit(0)
    except Exception:
        continue
sys.exit(1)
PY
  pad=1
fi

# Session Fact: seat (interim Hypr kiosk + supervised seats) | session
# (Gamescope owns the console session). Legacy value `gamescope` (Phase 2
# nested preference) maps to `session`.
MODE="seat"
FACT="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus/console-session-mode"
if [[ -f "${FACT}" ]]; then
  MODE="$(tr -d '[:space:]' <"${FACT}" || true)"
fi
case "${MODE}" in
  seat) ;;
  session|gamescope) MODE=session ;;
  *) MODE=seat ;;
esac
EFFECTIVE="seat"
if [[ "${MODE}" == "session" && "${gamescope_usable}" -eq 1 ]]; then
  EFFECTIVE="session"
fi
REPLACES=0
[[ "${EFFECTIVE}" == "session" ]] && REPLACES=1

python3 - <<PY
import json
print(json.dumps({
    "vulkan": bool(${vulkan}),
    "vulkanHw": bool(${vulkan_hw}),
    "gamescope": bool(${gamescope_bin}),
    "gamescopeUsable": bool(${gamescope_usable}),
    "gameScope": bool(${gamescope_usable}),
    "isVm": bool(${isvm}),
    "steam": bool(${steam}),
    "retroarch": bool(${retroarch}),
    "pad": bool(${pad}),
    "sessionMode": "${MODE}",
    "sessionEffective": "${EFFECTIVE}",
    "replacesHyprland": bool(${REPLACES}),
}))
PY
