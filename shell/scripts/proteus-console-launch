#!/usr/bin/env bash
# proteus-console-launch — run an app under console posture with VM-safe GL.
# Usage:
#   proteus-console-launch [--gamescope|--no-gamescope] <command...>
#   proteus-console-launch [--gamescope|--no-gamescope] --desktop <desktop-id>
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USE_GAMESCOPE=-1 # -1 auto, 0 off, 1 on
DESKTOP_ID=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --gamescope)
      USE_GAMESCOPE=1
      shift
      ;;
    --no-gamescope)
      USE_GAMESCOPE=0
      shift
      ;;
    --desktop)
      DESKTOP_ID="${2:-}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      echo "usage: $0 [--gamescope|--no-gamescope] [--desktop ID | command...]" >&2
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ -n "${DESKTOP_ID}" ]]; then
  DESKTOP_ID="${DESKTOP_ID%.desktop}"
  set -- gtk-launch "${DESKTOP_ID}"
elif [[ $# -eq 0 ]]; then
  echo "usage: $0 [--gamescope|--no-gamescope] [--desktop ID | command...]" >&2
  exit 2
fi

# Auto-wrap known game seats when not explicitly set
if [[ "${USE_GAMESCOPE}" -eq -1 ]]; then
  case "${1:-}" in
    steam|retroarch)
      USE_GAMESCOPE=1
      ;;
    *)
      USE_GAMESCOPE=0
      ;;
  esac
fi

is_vm() {
  local vendor product
  vendor="$(tr -d '\0' </sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
  product="$(tr -d '\0' </sys/class/dmi/id/product_name 2>/dev/null || true)"
  [[ "${vendor}${product}" =~ [Qq][Ee][Mm][Uu]|[Vv]irtual|[Vv]Mware|[Bb]ox|[Xx]en|[Bb]ochs ]]
}

ENV_ARGS=()
if [[ "${PROTEUS_TERMINAL_SOFTGL:-}" == "1" || "${PROTEUS_TERMINAL_SOFTGL:-}" == "true" ]]; then
  ENV_ARGS+=(LIBGL_ALWAYS_SOFTWARE=1)
elif is_vm; then
  ENV_ARGS+=(MESA_GL_VERSION_OVERRIDE=4.3 MESA_GLSL_VERSION_OVERRIDE=430)
fi

run_cmd() {
  if ((${#ENV_ARGS[@]})); then
    exec env "${ENV_ARGS[@]}" "$@"
  fi
  exec "$@"
}

if [[ -n "${DESKTOP_ID}" ]]; then
  if ! command -v gtk-launch >/dev/null 2>&1; then
    if command -v gio >/dev/null 2>&1; then
      set -- gio launch "${DESKTOP_ID}.desktop"
    elif command -v dex >/dev/null 2>&1; then
      set -- dex "${DESKTOP_ID}.desktop"
    else
      echo "proteus-console-launch: no gtk-launch/gio/dex for desktop ${DESKTOP_ID}" >&2
      exit 127
    fi
  fi
fi

gamescope_usable() {
  command -v gamescope >/dev/null 2>&1 || return 1
  # QEMU/VirGL guests usually have GL but no Vulkan → gamescope dies at startup.
  # Opt in with PROTEUS_FORCE_GAMESCOPE=1 once a Vulkan ICD works in-guest.
  if is_vm && [[ "${PROTEUS_FORCE_GAMESCOPE:-}" != "1" ]]; then
    return 1
  fi
  # Prefer live capabilities probe when present
  local caps="${HERE:-}/proteus-console-capabilities"
  if [[ -x "${caps}" ]]; then
    "${caps}" 2>/dev/null | grep -q '"gamescopeUsable": true' && return 0
    return 1
  fi
  if command -v vulkaninfo >/dev/null 2>&1; then
    vulkaninfo --summary 2>/dev/null | grep -qE 'GPU[0-9]+|deviceName' || return 1
  fi
  return 0
}

# Phase 2: session mode may supply adaptive gamescope flags (size + grab).
SESSION="${HERE}/proteus-console-session"
if [[ ! -x "${SESSION}" ]]; then
  SESSION="$(command -v proteus-console-session || true)"
fi

# Gamescope-owned session (Phase 3): the session compositor IS gamescope —
# never nest a second gamescope around a title (GS-in-GS).
if [[ "${PROTEUS_CONSOLE_SESSION:-}" == "gamescope" && "${USE_GAMESCOPE}" -eq 1 ]]; then
  USE_GAMESCOPE=0
fi

if [[ "${USE_GAMESCOPE}" -eq 1 ]]; then
  if gamescope_usable; then
    GS_FLAGS=(-f)
    if [[ -x "${SESSION}" ]]; then
      EXTRA="$("${SESSION}" resolve-flags 2>/dev/null || true)"
      if [[ -n "${EXTRA}" ]]; then
        # shellcheck disable=SC2206
        GS_FLAGS=(${EXTRA})
      fi
    fi
    if ((${#ENV_ARGS[@]})); then
      exec env "${ENV_ARGS[@]}" gamescope "${GS_FLAGS[@]}" -- "$@"
    fi
    exec gamescope "${GS_FLAGS[@]}" -- "$@"
  else
    echo "proteus-console-launch: gamescope unavailable (no Vulkan / VM) — running bare" >&2
  fi
fi

run_cmd "$@"
