#!/usr/bin/env bash
# proteus-gamescope — launch a title under owned game-present (default).
#
# Session compositor stays smithay. Preferred path: run the command bare on
# the ambient Wayland seat and ask proteus-compositor for game-present mode
# after the client maps. Gamescope nest is interim-only
# (PROTEUS_FORCE_GAMESCOPE=1 or Fact engine=gamescope).
#
# Steam launch options:  proteus-gamescope %command%
#
# Usage:
#   proteus-gamescope [--] <command...>
#   proteus-gamescope -h|--help
#
# Facts:
#   ~/.config/proteus/game-present     — owned knobs (scale_mode/fps/filter/engine)
#   ~/.config/proteus/gamescope-flags  — legacy nest argv (default -f)
# Env:
#   PROTEUS_FORCE_GAMESCOPE=1  — force gamescope nest when usable
#   PROTEUS_GAMESCOPE_FLAGS    — override nest flags
#   PROTEUS_GAME_PRESENT_ENGINE=owned|gamescope — override Fact engine
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(cd "${HERE}/../.." && pwd)"

usage() {
  echo "usage: proteus-gamescope [--] <command...>" >&2
  echo "  Default: bare exec + compositor game-present (owned)." >&2
  echo "  Steam: set launch options to: proteus-gamescope %command%" >&2
  echo "  Nest gamescope only with PROTEUS_FORCE_GAMESCOPE=1 or engine=gamescope." >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "proteus-gamescope: unknown option: $1 (pass game args after --)" >&2
      usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

is_vm() {
  local vendor product
  vendor="$(tr -d '\0' </sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
  product="$(tr -d '\0' </sys/class/dmi/id/product_name 2>/dev/null || true)"
  [[ "${vendor}${product}" =~ [Qq][Ee][Mm][Uu]|[Vv]irtual|[Vv]Mware|[Bb]ox|[Xx]en|[Bb]ochs ]]
}

already_inside_gamescope() {
  if [[ "${PROTEUS_CONSOLE_SESSION:-}" == "gamescope" ]]; then
    return 0
  fi
  case "${WAYLAND_DISPLAY:-}" in
    gamescope-*|gamescope) return 0 ;;
  esac
  if [[ -r /proc/$PPID/comm ]]; then
    local parent
    parent="$(tr -d '\0' </proc/$PPID/comm 2>/dev/null || true)"
    [[ "${parent}" == "gamescope" ]] && return 0
  fi
  return 1
}

resolve_ctl() {
  if [[ -n "${PROTEUS_COMPOSITORCTL:-}" && -x "${PROTEUS_COMPOSITORCTL}" ]]; then
    printf '%s' "${PROTEUS_COMPOSITORCTL}"
    return 0
  fi
  if command -v proteus-compositorctl >/dev/null 2>&1; then
    command -v proteus-compositorctl
    return 0
  fi
  for c in "${ROOT}/target/debug/proteus-compositorctl" \
           "${ROOT}/target/release/proteus-compositorctl"; do
    if [[ -x "${c}" ]]; then
      printf '%s' "${c}"
      return 0
    fi
  done
  return 1
}

owned_present_usable() {
  [[ -n "${WAYLAND_DISPLAY:-}" ]] || return 1
  local ctl
  ctl="$(resolve_ctl)" || return 1
  # Probe: compositor answers game-present query.
  "${ctl}" game-present >/dev/null 2>&1 || return 1
  return 0
}

present_engine() {
  if [[ -n "${PROTEUS_GAME_PRESENT_ENGINE:-}" ]]; then
    printf '%s' "$(printf '%s' "${PROTEUS_GAME_PRESENT_ENGINE}" | tr '[:upper:]' '[:lower:]')"
    return
  fi
  if [[ "${PROTEUS_FORCE_GAMESCOPE:-}" == "1" ]]; then
    printf 'gamescope'
    return
  fi
  local fact=""
  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    fact="${XDG_CONFIG_HOME}/proteus/game-present"
  else
    fact="${HOME:-/tmp}/.config/proteus/game-present"
  fi
  if [[ -f "${fact}" ]]; then
    local eng
    eng="$(python3 -c "import json,sys
try:
  print(json.load(open(sys.argv[1])).get('engine','owned'))
except Exception:
  print('owned')" "${fact}" 2>/dev/null || echo owned)"
    printf '%s' "$(printf '%s' "${eng}" | tr '[:upper:]' '[:lower:]')"
    return
  fi
  printf 'owned'
}

gamescope_usable() {
  command -v gamescope >/dev/null 2>&1 || return 1
  if is_vm && [[ "${PROTEUS_FORCE_GAMESCOPE:-}" != "1" ]]; then
    return 1
  fi
  local caps=""
  for c in "${HERE}/proteus-console-capabilities" \
    /usr/local/bin/proteus-console-capabilities; do
    if [[ -x "${c}" ]]; then
      caps="${c}"
      break
    fi
  done
  if [[ -n "${caps}" ]]; then
    "${caps}" 2>/dev/null | grep -q '"gamescopeUsable": true' && return 0
    return 1
  fi
  if command -v vulkaninfo >/dev/null 2>&1; then
    vulkaninfo --summary 2>/dev/null | grep -qE 'GPU[0-9]+|deviceName' || return 1
  fi
  return 0
}

resolve_flags() {
  if [[ -n "${PROTEUS_GAMESCOPE_FLAGS:-}" ]]; then
    # shellcheck disable=SC2206
    GS_FLAGS=(${PROTEUS_GAMESCOPE_FLAGS})
    return
  fi
  local fact=""
  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    fact="${XDG_CONFIG_HOME}/proteus/gamescope-flags"
  else
    fact="${HOME:-/tmp}/.config/proteus/gamescope-flags"
  fi
  if [[ -f "${fact}" ]]; then
    local raw
    raw="$(tr '\n' ' ' <"${fact}" | sed 's/#.*//g' | xargs 2>/dev/null || true)"
    if [[ -n "${raw}" ]]; then
      # shellcheck disable=SC2206
      GS_FLAGS=(${raw})
      return
    fi
  fi
  GS_FLAGS=(-f)
}

apply_game_present_async() {
  local ctl="$1"
  (
    local baseline after addr
    baseline="$("${ctl}" clients 2>/dev/null || echo '[]')"
    for _ in $(seq 1 80); do
      sleep 0.15
      after="$("${ctl}" clients 2>/dev/null || echo '[]')"
      addr="$(python3 -c "
import json,sys
base=json.loads(sys.argv[1]); after=json.loads(sys.argv[2])
base_a={c.get('address') for c in base if isinstance(c,dict)}
for c in after:
  if not isinstance(c,dict):
    continue
  a=c.get('address') or ''
  if a and a not in base_a:
    cls=(c.get('class') or '').lower()
    title=(c.get('title') or '')
    if 'quickshell' in cls or title.startswith('Proteus Settings'):
      continue
    print(a); break
" "${baseline}" "${after}" 2>/dev/null || true)"
      if [[ -n "${addr}" ]]; then
        "${ctl}" dispatch focuswindow "address:${addr}" >/dev/null 2>&1 || true
        "${ctl}" dispatch "game-present address ${addr}" >/dev/null 2>&1 || \
          "${ctl}" dispatch game-present on >/dev/null 2>&1 || true
        "${ctl}" dispatch "focus-stack set-title ${addr}" >/dev/null 2>&1 || true
        exit 0
      fi
    done
  ) >/dev/null 2>&1 &
}

run_bare() {
  exec "$@"
}

if already_inside_gamescope; then
  echo "proteus-gamescope: already inside gamescope — running bare (no nest)" >&2
  run_bare "$@"
fi

ENGINE="$(present_engine)"
CTL=""
if CTL="$(resolve_ctl 2>/dev/null)"; then
  :
else
  CTL=""
fi

# Owned path (default): bare + map into game-present when compositor answers.
if [[ "${ENGINE}" != "gamescope" ]] && owned_present_usable; then
  echo "proteus-gamescope: owned game-present (no nest)" >&2
  apply_game_present_async "${CTL}"
  run_bare "$@"
fi

# Interim nest — only when forced / Fact engine=gamescope and usable.
if [[ "${ENGINE}" == "gamescope" ]] || [[ "${PROTEUS_FORCE_GAMESCOPE:-}" == "1" ]]; then
  if gamescope_usable && [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
    echo "proteus-gamescope: interim gamescope nest (FORCE/engine=gamescope)" >&2
    resolve_flags
    exec gamescope "${GS_FLAGS[@]}" -- "$@"
  fi
  echo "proteus-gamescope: nest wanted but unusable — running bare" >&2
  run_bare "$@"
fi

# Fallback: bare without present (no ctl / nested missing).
echo "proteus-gamescope: compositor game-present unavailable — running bare" >&2
run_bare "$@"
