#!/usr/bin/env bash
# proteus-workspace — Spaces band math / fixtures + live compositorctl path.
#
# Live path: proteus-compositorctl (Smithay). Per-output boards are logical
# 1–10 (`workspace N` synced · `workspace N,output:NAME` local). Band math
# (physical = logical + monitorIndex × 10) is derived for status/fixtures.
#
# Mode from ~/.config/proteus/settings.json workspaceMode:
#   synced     — Super+N / goto switches every display together (default)
#   perDisplay — switch only the focused (or --monitor) display
# --local / --synced override the setting for one invocation.
#
# Scratch / specials: compositor maps all special:* → special:minimized park.
#   scratch-toggle — park/restore focused window
#   scratch-move   — park focused window
# Custom specials (settings.json specialWorkspaces; reserved scratch/minimized):
#   special-toggle|special-move NAME · special-list
#   special-toggle-index|special-move-index N — 1-based slot (keybinds / strip)
set -euo pipefail

STRIDE=10
MAX_LOGICAL=10
SCRATCH_NAME="${PROTEUS_SCRATCH_NAME:-scratch}"
MINIMIZED_NAME="${PROTEUS_MINIMIZED_NAME:-minimized}"
SETTINGS="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus/settings.json"

usage() {
  echo "Usage: proteus-workspace {goto|next|prev|move|scratch-toggle|scratch-move|special-toggle|special-move|special-toggle-index|special-move-index|special-list|status|ensure|migrate-disconnect|apply-names|selftest} [N|NAME] [--local|--synced] [--monitor NAME] [--fixture]" >&2
  exit 2
}

# Band-math gate (no compositor). Used by spaces-smoke / offline CI.
selftest() {
  local fail=0
  check() {
    local got="$1" want="$2" label="$3"
    if [[ "${got}" != "${want}" ]]; then
      echo "proteus-workspace selftest FAIL ${label}: got=${got} want=${want}" >&2
      fail=1
    fi
  }
  check "$(physical_of 1 0)" "1" "physical_of 1@0"
  check "$(physical_of 3 1)" "13" "physical_of 3@1"
  check "$(physical_of 10 2)" "30" "physical_of 10@2"
  check "$(logical_of 1)" "1" "logical_of 1"
  check "$(logical_of 13)" "3" "logical_of 13"
  check "$(logical_of 30)" "10" "logical_of 30"
  check "$(clamp_logical 0)" "1" "clamp low"
  check "$(clamp_logical 11)" "10" "clamp high"
  check "$(clamp_logical 7)" "7" "clamp mid"
  # 2-head dogfood: bands exclusive; synced logical N → physical N and N+10
  check "$(physical_of 5 0)" "5" "2head logical5@0"
  check "$(physical_of 5 1)" "15" "2head logical5@1"
  local b0_lo=1 b0_hi=10 b1_lo=11 b1_hi=20
  check "${b0_hi}" "10" "band0 hi"
  check "${b1_lo}" "11" "band1 lo"
  [[ "${b0_hi}" -lt "${b1_lo}" ]] || {
    echo "proteus-workspace selftest FAIL band overlap" >&2
    fail=1
  }
  # Disconnect migration: orphan band → primary logical (monitorCount=1)
  STRIDE="${STRIDE}" python3 - <<'PY' || fail=1
import os, sys
stride = int(os.environ.get("STRIDE", "10"))

def target(wid, n_mons):
    if wid < 1:
        return None
    band = (wid - 1) // stride
    if band < n_mons:
        return None
    logical = ((wid - 1) % stride) + 1
    return logical  # primary band index 0

assert target(15, 1) == 5, target(15, 1)
assert target(11, 1) == 1, target(11, 1)
assert target(20, 1) == 10, target(20, 1)
assert target(5, 1) is None
assert target(15, 2) is None
assert target(-98, 1) is None
print("migrate-plan math ok")
PY
  # Scratchpad name is fixed product SoT (≠ special:minimized).
  [[ "${SCRATCH_NAME}" == "scratch" ]] || {
    echo "proteus-workspace selftest FAIL scratch name: ${SCRATCH_NAME}" >&2
    fail=1
  }
  valid_special_name "notes" || {
    echo "proteus-workspace selftest FAIL valid notes" >&2
    fail=1
  }
  valid_special_name "scratch" || {
    echo "proteus-workspace selftest FAIL reserved scratch still valid" >&2
    fail=1
  }
  if valid_special_name "Bad Name" || valid_special_name "" || valid_special_name "1abc"; then
    echo "proteus-workspace selftest FAIL invalid special names accepted" >&2
    fail=1
  fi
  [[ "${fail}" -eq 0 ]] || exit 1
  echo "proteus-workspace selftest: OK"
}

# Special workspace slug: [a-z][a-z0-9-]{0,23}
valid_special_name() {
  local n="${1:-}"
  [[ "${n}" =~ ^[a-z][a-z0-9-]{0,23}$ ]]
}

is_reserved_special() {
  local n="${1:-}"
  [[ "${n}" == "${SCRATCH_NAME}" || "${n}" == "${MINIMIZED_NAME}" ]]
}

emit_scratch_fixture() {
  local action="$1"
  python3 - "${action}" "${SCRATCH_NAME}" <<'PY'
import json, sys
print(json.dumps({
    "ok": True,
    "fixture": True,
    "action": sys.argv[1],
    "name": sys.argv[2],
    "workspace": f"special:{sys.argv[2]}",
}))
PY
}

scratch_toggle() {
  local fixture="${1:-0}"
  if [[ "${fixture}" -eq 1 ]]; then
    emit_scratch_fixture "scratch-toggle"
    return 0
  fi
  toggle_special "${SCRATCH_NAME}"
}

scratch_move() {
  local fixture="${1:-0}"
  if [[ "${fixture}" -eq 1 ]]; then
    emit_scratch_fixture "scratch-move"
    return 0
  fi
  need_ctl
  ctl_dispatch "movetoworkspacesilent special:${SCRATCH_NAME}"
}

emit_special_fixture() {
  local action="$1" name="$2"
  python3 - "${action}" "${name}" <<'PY'
import json, sys
print(json.dumps({
    "ok": True,
    "fixture": True,
    "action": sys.argv[1],
    "name": sys.argv[2],
    "workspace": f"special:{sys.argv[2]}",
}))
PY
}

special_toggle() {
  local name="${1:-}" fixture="${2:-0}"
  valid_special_name "${name}" || {
    echo "proteus-workspace: invalid special name: ${name}" >&2
    return 2
  }
  if [[ "${fixture}" -eq 1 ]]; then
    emit_special_fixture "special-toggle" "${name}"
    return 0
  fi
  toggle_special "${name}"
}

special_move() {
  local name="${1:-}" fixture="${2:-0}"
  valid_special_name "${name}" || {
    echo "proteus-workspace: invalid special name: ${name}" >&2
    return 2
  }
  if [[ "${fixture}" -eq 1 ]]; then
    emit_special_fixture "special-move" "${name}"
    return 0
  fi
  need_ctl
  ctl_dispatch "movetoworkspacesilent special:${name}"
}

# Resolve 1-based index into settings.json specialWorkspaces (empty → "").
special_name_at_index() {
  local idx="${1:-}"
  SETTINGS_PATH="${SETTINGS}" INDEX="${idx}" python3 - <<'PY'
import json, os, re, sys
idx = int(os.environ.get("INDEX") or "0")
settings = os.environ.get("SETTINGS_PATH", "")
pat = re.compile(r"^[a-z][a-z0-9-]{0,23}$")
reserved = {"scratch", "minimized"}
raw = []
if os.path.isfile(settings):
    try:
        with open(settings, encoding="utf-8") as f:
            data = json.load(f)
        raw = data.get("specialWorkspaces") or []
    except Exception:
        raw = []
custom = []
seen = set()
for item in raw if isinstance(raw, list) else []:
    s = str(item or "").strip().lower()
    if not pat.match(s) or s in reserved or s in seen:
        continue
    seen.add(s)
    custom.append(s)
    if len(custom) >= 8:
        break
if idx < 1 or idx > len(custom):
    sys.exit(0)
print(custom[idx - 1])
PY
}

special_by_index() {
  local action="${1:-}" idx="${2:-}" fixture="${3:-0}"
  [[ "${action}" == "toggle" || "${action}" == "move" ]] || return 2
  [[ "${idx}" =~ ^[1-8]$ ]] || {
    echo "proteus-workspace: special index must be 1–8" >&2
    return 2
  }
  local name=""
  if [[ "${fixture}" -eq 1 ]]; then
    # Fixture slots: 1=notes, 2=mail
    case "${idx}" in
      1) name="notes" ;;
      2) name="mail" ;;
      *) name="" ;;
    esac
    if [[ -z "${name}" ]]; then
      python3 - <<PY
import json
print(json.dumps({"ok": True, "fixture": True, "action": "special-${action}-index",
                  "index": ${idx}, "name": "", "empty": True}))
PY
      return 0
    fi
    emit_special_fixture "special-${action}-index" "${name}"
    return 0
  fi
  name="$(special_name_at_index "${idx}" || true)"
  if [[ -z "${name}" ]]; then
    echo "proteus-workspace: no special at index ${idx}" >&2
    return 1
  fi
  if [[ "${action}" == "toggle" ]]; then
    special_toggle "${name}" 0
  else
    special_move "${name}" 0
  fi
}

# List reserved + custom specials from settings.json (offline-friendly).
special_list() {
  local fixture="${1:-0}"
  SETTINGS_PATH="${SETTINGS}" SCRATCH="${SCRATCH_NAME}" MINIMIZED="${MINIMIZED_NAME}" \
    FIXTURE="${fixture}" python3 - <<'PY'
import json, os, re, sys

settings = os.environ.get("SETTINGS_PATH", "")
scratch = os.environ.get("SCRATCH", "scratch")
minimized = os.environ.get("MINIMIZED", "minimized")
fixture = os.environ.get("FIXTURE", "0") == "1"
pat = re.compile(r"^[a-z][a-z0-9-]{0,23}$")
custom = []
raw = []
if fixture:
    raw = ["notes", "scratch", "Bad", "notes"]
elif os.path.isfile(settings):
    try:
        with open(settings, encoding="utf-8") as f:
            data = json.load(f)
        raw = data.get("specialWorkspaces") or []
    except Exception:
        raw = []
seen = set()
for item in raw if isinstance(raw, list) else []:
    s = str(item or "").strip().lower()
    if not pat.match(s) or s in (scratch, minimized) or s in seen:
        continue
    seen.add(s)
    custom.append(s)
    if len(custom) >= 8:
        break
print(json.dumps({
    "ok": True,
    "fixture": fixture,
    "reserved": [scratch, minimized],
    "custom": custom,
    "all": [scratch, minimized] + custom,
}))
PY
}

emit_status_fixture() {
  python3 - <<'PY'
import json
print(json.dumps({
    "ok": True,
    "fixture": True,
    "mode": "synced",
    "monitorCount": 2,
    "monitors": [
        {"index": 0, "name": "HDMI-A-1", "focused": True,
         "activeLogical": 1, "activePhysical": 1, "bandStart": 1, "bandEnd": 10},
        {"index": 1, "name": "DP-1", "focused": False,
         "activeLogical": 1, "activePhysical": 11, "bandStart": 11, "bandEnd": 20},
    ],
    "summary": "2 displays · synced · bands ×10",
    "hint": "Fixture — plug a second display or use live proteus-compositorctl for real status",
}, separators=(",", ":")))
PY
}

emit_status() {
  local mode
  mode="$(read_mode)"
  need_ctl
  STRIDE="${STRIDE}" MAX_LOGICAL="${MAX_LOGICAL}" MODE="${mode}" CTL="${CTL}" python3 - <<'PY'
import json, os, subprocess, sys
stride = int(os.environ.get("STRIDE", "10"))
mode = os.environ.get("MODE", "synced")
ctl = os.environ.get("CTL", "proteus-compositorctl")
try:
    mons = json.loads(subprocess.check_output([ctl, "monitors"], text=True))
    aw = json.loads(subprocess.check_output([ctl, "activeworkspace"], text=True))
except Exception as e:
    print(json.dumps({"ok": False, "error": f"ctl: {e}"}))
    sys.exit(0)
if not isinstance(mons, list):
    mons = []
# Stable order: focused first, then name.
mons = sorted(
    mons,
    key=lambda m: (0 if m.get("focused") else 1, str(m.get("name") or "")),
)
try:
    seat_aw = int(aw.get("id") or 1)
except (TypeError, ValueError):
    seat_aw = 1
out = []
for i, m in enumerate(mons):
    maw = m.get("activeWorkspace") or {}
    try:
        logical = int(maw.get("id") or seat_aw or 1)
    except (TypeError, ValueError):
        logical = seat_aw if seat_aw >= 1 else 1
    if logical < 1:
        logical = 1
    logical = ((logical - 1) % stride) + 1
    physical = logical + i * stride
    out.append({
        "index": i,
        "name": str(m.get("name") or ""),
        "focused": bool(m.get("focused")),
        "activeLogical": logical,
        "activePhysical": physical,
        "bandStart": 1 + i * stride,
        "bandEnd": (i + 1) * stride,
    })
n = len(out)
if n <= 0:
    summary = "No displays"
    hint = "Waiting for compositor monitors"
elif n == 1:
    summary = f"1 display · {mode} · Spaces 1–10"
    hint = "Spaces overview is primary UI; proteus-workspace for scripts/keybinds"
else:
    summary = f"{n} displays · {mode} · per-output boards (bands ×{stride})"
    hint = "synced = all heads · perDisplay/--local = focused (or --monitor) head"
print(json.dumps({
    "ok": True,
    "fixture": False,
    "mode": mode,
    "monitorCount": n,
    "monitors": out,
    "summary": summary,
    "hint": hint,
}, separators=(",", ":")))
PY
}

# Read workspaceNames[0..9] from settings.json (logical 1–10).
read_names() {
  python3 - "$SETTINGS" <<'PY'
import json, sys
path = sys.argv[1]
names = [""] * 10
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    raw = data.get("workspaceNames") or []
    if isinstance(raw, list):
        for i in range(10):
            if i < len(raw) and raw[i] is not None:
                s = str(raw[i]).strip()[:24]
                names[i] = s
except Exception:
    pass
print("\n".join(names))
PY
}

# Push settings.json labels onto workspaces.
# Smithay has no renameworkspace yet — iced Spaces overview owns labels via
# workspaceNames Fact. Keep command for Settings/ensure callers (no-op OK).
apply_names() {
  need_ctl
  local n=0
  while IFS=$'\t' read -r _id name _focused _aw; do
    [[ -n "${name}" ]] || continue
    n=$((n + 1))
  done < <(monitor_rows)
  if [[ "${n}" -eq 0 ]]; then
    echo "proteus-workspace: apply-names — no monitors" >&2
    return 1
  fi
  # Labels live in settings.json → shell Spaces overview; compositor rename Out.
  return 0
}

# Move clients on orphan bands (index ≥ live monitor count) to the matching
# logical Space on band 0 (primary). Idempotent when no orphans. Special /
# negative workspace ids skipped. --fixture → plan JSON only (no ctl writes).
migrate_disconnect() {
  local fixture="${1:-0}"
  if [[ "${fixture}" -ne 1 ]]; then
    need_ctl
  fi
  STRIDE="${STRIDE}" MAX_LOGICAL="${MAX_LOGICAL}" FIXTURE="${fixture}" \
    CTL="${CTL:-proteus-compositorctl}" python3 - <<'PY'
import json, os, subprocess, sys

stride = int(os.environ.get("STRIDE", "10"))
fixture = os.environ.get("FIXTURE", "0") == "1"
ctl = os.environ.get("CTL", "proteus-compositorctl")

def plan_moves(mons, clients):
    n = len(mons)
    moves = []
    for c in clients:
        ws = c.get("workspace") or {}
        try:
            wid = int(ws.get("id") or 0)
        except (TypeError, ValueError):
            continue
        if wid < 1:
            continue
        band = (wid - 1) // stride
        if band < n:
            continue
        logical = ((wid - 1) % stride) + 1
        target = logical  # band 0
        addr = str(c.get("address") or "")
        if not addr:
            continue
        moves.append({
            "address": addr,
            "from": wid,
            "to": target,
            "logical": logical,
        })
    return n, moves

if fixture:
    mons = [{"id": 0, "name": "HDMI-A-1"}]
    clients = [
        {"address": "0xaaa", "workspace": {"id": 15}},
        {"address": "0xbbb", "workspace": {"id": 5}},
        {"address": "0xccc", "workspace": {"id": 20}},
        {"address": "0xddd", "workspace": {"id": -98}},
    ]
    n, moves = plan_moves(mons, clients)
    print(json.dumps({
        "ok": True,
        "fixture": True,
        "monitorCount": n,
        "moved": len(moves),
        "moves": moves,
    }, separators=(",", ":")))
    sys.exit(0)

try:
    mons = json.loads(subprocess.check_output([ctl, "monitors"], text=True))
    clients = json.loads(subprocess.check_output([ctl, "clients"], text=True))
except Exception as e:
    print(json.dumps({"ok": False, "error": str(e)}), file=sys.stderr)
    sys.exit(1)

if not isinstance(mons, list):
    mons = []
if not isinstance(clients, list):
    clients = []
mons = sorted(
    mons,
    key=lambda m: (0 if m.get("focused") else 1, str(m.get("name") or "")),
)
n, moves = plan_moves(mons, clients)
for m in moves:
    addr = m["address"]
    if not addr.startswith("address:"):
        addr = f"address:{addr}"
    subprocess.run(
        [ctl, "dispatch", f"movetoworkspacesilent {m['to']},{addr}"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
print(json.dumps({
    "ok": True,
    "fixture": False,
    "monitorCount": n,
    "moved": len(moves),
    "moves": moves,
}, separators=(",", ":")))
PY
}

# Hotplug helper — migrate orphans, then rebind each head to its logical board.
ensure_bands() {
  migrate_disconnect 0 >/dev/null || true
  local i=0 name focused aw logical restore="" batch=""
  while IFS=$'\t' read -r _id name focused aw; do
    [[ -n "${name}" ]] || continue
    if [[ "${focused}" == "1" ]]; then
      restore="${name}"
    fi
    logical="$(logical_of "${aw}")"
    logical="$(clamp_logical "${logical}")"
    batch+="dispatch workspace ${logical},output:${name};"
    i=$((i + 1))
  done < <(monitor_rows)
  if [[ "${i}" -eq 0 ]]; then
    echo "proteus-workspace: ensure — no monitors" >&2
    return 1
  fi
  if [[ -n "${restore}" ]]; then
    batch+="dispatch focusoutput ${restore};"
  fi
  dispatch_batch "${batch}"
}

need_ctl() {
  if [[ -n "${CTL:-}" ]]; then
    return 0
  fi
  if command -v proteus-compositorctl >/dev/null 2>&1; then
    CTL="proteus-compositorctl"
    return 0
  fi
  echo "proteus-workspace: proteus-compositorctl not found" >&2
  exit 1
}

# Normalize + dispatch one compositor verb (hypr-shaped aliases accepted).
ctl_dispatch() {
  local verb="${1:-}"
  need_ctl
  verb="${verb#"${verb%%[![:space:]]*}"}"
  verb="${verb%"${verb##*[![:space:]]}"}"
  [[ -n "${verb}" ]] || return 0
  case "${verb}" in
    dispatch\ *)
      verb="${verb#dispatch }"
      ;;
  esac
  case "${verb}" in
    focusmonitor\ *)
      verb="focusoutput ${verb#focusmonitor }"
      ;;
    movetoworkspace\ *)
      verb="movetoworkspacesilent ${verb#movetoworkspace }"
      ;;
    moveworkspacetomonitor\ *|renameworkspace\ *|togglespecialworkspace\ *)
      # Not implemented on Smithay spike — silently skip.
      return 0
      ;;
  esac
  "${CTL}" dispatch "${verb}" >/dev/null
}

# Park/restore focused window via special:* (all specials → minimized park).
toggle_special() {
  local name="${1:-}"
  need_ctl
  CTL="${CTL}" SPECIAL="${name}" python3 - <<'PY'
import json, os, subprocess, sys
ctl = os.environ["CTL"]
name = os.environ.get("SPECIAL", "scratch")
try:
    win = json.loads(subprocess.check_output([ctl, "activewindow"], text=True))
    aw = json.loads(subprocess.check_output([ctl, "activeworkspace"], text=True))
except Exception as e:
    print(f"proteus-workspace: toggle special: {e}", file=sys.stderr)
    sys.exit(1)
ws = win.get("workspace") or {}
try:
    wid = int(ws.get("id") or 0)
except (TypeError, ValueError):
    wid = 0
try:
    restore = int(aw.get("id") or 1)
except (TypeError, ValueError):
    restore = 1
if restore < 1:
    restore = 1
if wid < 0:
    verb = f"movetoworkspacesilent {restore}"
else:
    verb = f"movetoworkspacesilent special:{name}"
subprocess.run(
    [ctl, "dispatch", verb],
    check=False,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)
PY
}

read_mode() {
  python3 - "$SETTINGS" <<'PY'
import json, sys
path = sys.argv[1]
mode = "synced"
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    m = data.get("workspaceMode") or "synced"
    if m in ("synced", "perDisplay"):
        mode = m
except Exception:
    pass
print(mode)
PY
}

# Sorted monitor rows: "id\tname\tfocused\tactiveWorkspaceId"
# id is enumerate index; active id is per-output when compositor reports it.
monitor_rows() {
  need_ctl
  CTL="${CTL}" python3 - <<'PY'
import json, os, subprocess, sys
ctl = os.environ.get("CTL", "proteus-compositorctl")
try:
    mons = json.loads(subprocess.check_output([ctl, "monitors"], text=True))
    aw = json.loads(subprocess.check_output([ctl, "activeworkspace"], text=True))
except Exception as e:
    print(f"proteus-workspace: monitors: {e}", file=sys.stderr)
    sys.exit(1)
if not isinstance(mons, list):
    mons = []
try:
    seat_wid = int(aw.get("id") or 1)
except (TypeError, ValueError):
    seat_wid = 1
if seat_wid < 1:
    seat_wid = 1
mons = sorted(
    mons,
    key=lambda m: (0 if m.get("focused") else 1, str(m.get("name") or "")),
)
for i, m in enumerate(mons):
    maw = m.get("activeWorkspace") or {}
    try:
        wid = int(maw.get("id") or seat_wid)
    except (TypeError, ValueError):
        wid = seat_wid
    if wid < 1:
        wid = seat_wid
    focused = 1 if m.get("focused") else 0
    print(f"{i}\t{m.get('name', '')}\t{focused}\t{wid}")
PY
}

logical_of() {
  local physical="$1"
  if [[ "${physical}" -lt 1 ]]; then
    echo 1
    return
  fi
  echo $(( ((physical - 1) % STRIDE) + 1 ))
}

physical_of() {
  local logical="$1"
  local index="$2"
  echo $(( logical + index * STRIDE ))
}

clamp_logical() {
  local n="$1"
  if [[ "${n}" -lt 1 ]]; then
    echo 1
  elif [[ "${n}" -gt "${MAX_LOGICAL}" ]]; then
    echo "${MAX_LOGICAL}"
  else
    echo "${n}"
  fi
}

dispatch_batch() {
  # Semicolon-separated hypr-shaped "dispatch …" verbs → sequential ctl_dispatch.
  local cmds="$1"
  if [[ -z "${cmds}" ]]; then
    return 0
  fi
  local IFS=';'
  local part
  for part in ${cmds}; do
    part="${part#"${part%%[![:space:]]*}"}"
    part="${part%"${part##*[![:space:]]}"}"
    [[ -n "${part}" ]] || continue
    ctl_dispatch "${part}"
  done
}

# Synced: every head → logical N.
goto_synced() {
  local logical
  logical="$(clamp_logical "$1")"
  ctl_dispatch "workspace ${logical}"
}

# Local: focused (or --monitor) head only.
goto_local() {
  local logical want_mon="${2:-}" name focused
  logical="$(clamp_logical "$1")"
  if [[ -z "${want_mon}" ]]; then
    while IFS=$'\t' read -r _id name focused _aw; do
      [[ -n "${name}" ]] || continue
      if [[ "${focused}" == "1" ]]; then
        want_mon="${name}"
        break
      fi
    done < <(monitor_rows)
  fi
  if [[ -n "${want_mon}" ]]; then
    ctl_dispatch "workspace ${logical},output:${want_mon}"
  else
    ctl_dispatch "workspace ${logical}"
  fi
}

current_logical_on() {
  local want_mon="${1:-}"
  local i=0 name focused aw
  while IFS=$'\t' read -r _id name focused aw; do
    [[ -n "${name}" ]] || continue
    if [[ -n "${want_mon}" ]]; then
      if [[ "${name}" == "${want_mon}" ]]; then
        logical_of "${aw}"
        return 0
      fi
    elif [[ "${focused}" == "1" ]]; then
      logical_of "${aw}"
      return 0
    fi
    i=$((i + 1))
  done < <(monitor_rows)
  echo 1
}

move_to_logical() {
  local logical
  logical="$(clamp_logical "$1")"
  ctl_dispatch "movetoworkspacesilent ${logical}"
}

main() {
  [[ $# -ge 1 ]] || usage

  local cmd="$1"
  shift

  if [[ "${cmd}" == "selftest" ]]; then
    selftest
    return 0
  fi

  local force=""
  local monitor=""
  local num=""
  local fixture=0
  if [[ "${PROTEUS_WORKSPACE_FIXTURE:-}" == "1" ]]; then
    fixture=1
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)
        force="local"
        shift
        ;;
      --synced)
        force="synced"
        shift
        ;;
      --fixture)
        fixture=1
        shift
        ;;
      --monitor)
        [[ $# -ge 2 ]] || usage
        monitor="$2"
        shift 2
        ;;
      --monitor=*)
        monitor="${1#--monitor=}"
        shift
        ;;
      -*)
        usage
        ;;
      *)
        if [[ -z "${num}" ]]; then
          num="$1"
        else
          usage
        fi
        shift
        ;;
    esac
  done

  if [[ "${cmd}" == "status" ]]; then
    if [[ "${fixture}" -eq 1 ]]; then
      emit_status_fixture
    else
      emit_status
    fi
    return 0
  fi

  if [[ "${cmd}" == "migrate-disconnect" ]]; then
    if [[ "${fixture}" -eq 1 ]]; then
      migrate_disconnect 1
    else
      migrate_disconnect 0
    fi
    return 0
  fi

  if [[ "${cmd}" == "scratch-toggle" ]]; then
    scratch_toggle "${fixture}"
    return 0
  fi

  if [[ "${cmd}" == "scratch-move" ]]; then
    scratch_move "${fixture}"
    return 0
  fi

  if [[ "${cmd}" == "special-list" ]]; then
    special_list "${fixture}"
    return 0
  fi

  if [[ "${cmd}" == "special-toggle" ]]; then
    [[ -n "${num}" ]] || usage
    special_toggle "${num}" "${fixture}"
    return 0
  fi

  if [[ "${cmd}" == "special-move" ]]; then
    [[ -n "${num}" ]] || usage
    special_move "${num}" "${fixture}"
    return 0
  fi

  if [[ "${cmd}" == "special-toggle-index" ]]; then
    [[ -n "${num}" ]] || usage
    special_by_index "toggle" "${num}" "${fixture}"
    return 0
  fi

  if [[ "${cmd}" == "special-move-index" ]]; then
    [[ -n "${num}" ]] || usage
    special_by_index "move" "${num}" "${fixture}"
    return 0
  fi

  need_ctl

  if [[ "${cmd}" == "ensure" ]]; then
    ensure_bands
    apply_names || true
    return 0
  fi

  if [[ "${cmd}" == "apply-names" ]]; then
    apply_names
    return 0
  fi

  local mode
  mode="$(read_mode)"
  if [[ "${force}" == "local" ]]; then
    mode="perDisplay"
  elif [[ "${force}" == "synced" ]]; then
    mode="synced"
  fi
  # Explicit --monitor implies this-display switch unless --synced forced.
  if [[ -n "${monitor}" && "${force}" != "synced" ]]; then
    mode="perDisplay"
  fi

  case "${cmd}" in
    goto)
      [[ -n "${num}" ]] || usage
      if [[ "${mode}" == "synced" ]]; then
        goto_synced "${num}"
      else
        goto_local "${num}" "${monitor}"
      fi
      ;;
    next|prev)
      local cur delta=1
      cur="$(current_logical_on "${monitor}")"
      if [[ "${cmd}" == "prev" ]]; then
        delta=-1
      fi
      local target=$((cur + delta))
      if [[ "${mode}" == "synced" ]]; then
        goto_synced "${target}"
      else
        goto_local "${target}" "${monitor}"
      fi
      ;;
    move)
      [[ -n "${num}" ]] || usage
      move_to_logical "${num}"
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
