#!/usr/bin/env bash
# proteus-console-session — Legacy console session Fact helper.
# Fact: ~/.config/proteus/console-session-mode  →  seat | session
#
# Shipping: proteus-session always uses owned smithay. `session` / `gamescope`
# Fact values are legacy; sessionEffective is seat unless PROTEUS_FORCE_GAMESCOPE=1.
# resolve-flags still emits gamescope argv for the FORCE gs-session path.
#
# Usage:
#   proteus-console-session status
#   proteus-console-session set-mode seat|session
#   proteus-console-session resolve-flags   # gamescope argv extras (or empty)
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
FACT_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus"
FACT="${FACT_DIR}/console-session-mode"
CAPS="${HERE}/proteus-console-capabilities"
if [[ ! -x "${CAPS}" ]]; then
  CAPS="$(command -v proteus-console-capabilities || true)"
fi

usage() {
  echo "usage: $0 status|set-mode|resolve-flags [args…]" >&2
  echo "       $0 set-mode seat|session" >&2
  exit 2
}

read_mode() {
  local m="seat"
  if [[ -f "${FACT}" ]]; then
    m="$(tr -d '[:space:]' <"${FACT}" || true)"
  fi
  case "${m}" in
    seat) printf 'seat' ;;
    session|gamescope) printf 'session' ;;
    *) printf 'seat' ;;
  esac
}

caps_json() {
  if [[ -x "${CAPS}" ]]; then
    "${CAPS}" 2>/dev/null || echo '{}'
  else
    echo '{}'
  fi
}

monitor_size() {
  # Best-effort focused monitor WxH from compositorctl; empty if unavailable.
  python3 - <<'PY' 2>/dev/null || true
import json, os, subprocess, sys
ctl = os.environ.get("PROTEUS_COMPOSITORCTL") or "proteus-compositorctl"
try:
    mons = json.loads(subprocess.check_output([ctl, "monitors"], text=True, timeout=2))
except Exception:
    sys.exit(0)
if not isinstance(mons, list) or not mons:
    sys.exit(0)
m = mons[0]
w = int(m.get("width") or (m.get("size") or [0, 0])[0] or 0)
h = int(m.get("height") or (m.get("size") or [0, 0])[1] or 0)
if w > 0 and h > 0:
    print(f"{w}x{h}")
PY
}

cmd_status() {
  local mode usable effective
  mode="$(read_mode)"
  usable=false
  if echo "$(caps_json)" | grep -q '"gamescopeUsable": true'; then
    usable=true
  fi
  # Match proteus-console-capabilities: seat unless FORCE + session + usable.
  effective="seat"
  if [[ "${PROTEUS_FORCE_GAMESCOPE:-}" == "1" && "${mode}" == "session" && "${usable}" == "true" ]]; then
    effective="session"
  fi
  python3 - <<PY
import json
print(json.dumps({
    "ok": True,
    "mode": "${mode}",
    "effective": "${effective}",
    "gamescopeUsable": "${usable}" == "true",
    "fact": "${FACT}",
    "replacesHyprland": False,
    "hint": "shipping: owned smithay always; session Fact is legacy; Gamescope session only with PROTEUS_FORCE_GAMESCOPE=1",
}))
PY
}

cmd_set_mode() {
  local m="${1:-}"
  case "${m}" in
    seat) ;;
    session|gamescope) m=session ;;
    *)
      echo '{"ok":false,"error":"mode must be seat|session"}'
      exit 1
      ;;
  esac
  mkdir -p "${FACT_DIR}"
  printf '%s\n' "${m}" >"${FACT}"
  python3 - <<PY
import json
print(json.dumps({"ok": True, "mode": "${m}", "fact": "${FACT}"}))
PY
}

cmd_resolve_flags() {
  # stdout: space-separated gamescope flags for FORCE gs-session only.
  local mode effective size
  mode="$(read_mode)"
  effective="seat"
  if [[ "${PROTEUS_FORCE_GAMESCOPE:-}" == "1" && "${mode}" == "session" ]] \
    && echo "$(caps_json)" | grep -q '"gamescopeUsable": true'; then
    effective="session"
  fi
  if [[ "${effective}" != "session" ]]; then
    exit 0
  fi
  size="$(monitor_size)"
  if [[ -n "${size}" ]]; then
    local w="${size%x*}"
    local h="${size#*x}"
    printf -- '-W %s -H %s -f\n' "${w}" "${h}"
  else
    printf -- '-f\n'
  fi
}

[[ $# -ge 1 ]] || usage
case "$1" in
  status) cmd_status ;;
  set-mode)
    shift
    cmd_set_mode "${1:-}"
    ;;
  resolve-flags) cmd_resolve_flags ;;
  *) usage ;;
esac
