#!/usr/bin/env bash
# proteus-console-session — Console session engine preference (Phase 3).
# Fact: ~/.config/proteus/console-session-mode  →  seat | session
#   seat    — interim: Hyprland kiosk + supervised seats (per-title/nested GS)
#   session — Gamescope owns the console session (bare metal / GPU passthrough);
#             engine picked at login by proteus-session, applied on next flip.
# Legacy Fact value `gamescope` (Phase 2 nested preference) reads as `session`.
# Usage:
#   proteus-console-session status
#   proteus-console-session set-mode seat|session
#   proteus-console-session resolve-flags   # gamescope argv extras (or empty)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FACT_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/proteus"
FACT="${FACT_DIR}/console-session-mode"
CAPS="${HERE}/proteus-console-capabilities"
if [[ ! -x "${CAPS}" ]]; then
  CAPS="$(command -v proteus-console-capabilities || true)"
fi

usage() {
  echo "usage: $0 status|set-mode|resolve-flags [args…]" >&2
  echo "       $0 set-mode seat|session" >&2
  exit 2
}

read_mode() {
  local m="seat"
  if [[ -f "${FACT}" ]]; then
    m="$(tr -d '[:space:]' <"${FACT}" || true)"
  fi
  case "${m}" in
    seat) printf 'seat' ;;
    session|gamescope) printf 'session' ;;
    *) printf 'seat' ;;
  esac
}

caps_json() {
  if [[ -x "${CAPS}" ]]; then
    "${CAPS}" 2>/dev/null || echo '{}'
  else
    echo '{}'
  fi
}

monitor_size() {
  # Best-effort focused monitor WxH from hyprctl; empty if unavailable
  # (e.g. already inside the Gamescope session — caller falls back).
  python3 - <<'PY' 2>/dev/null || true
import json, subprocess, sys
try:
    mons = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"], text=True, timeout=2))
except Exception:
    sys.exit(0)
if not isinstance(mons, list) or not mons:
    sys.exit(0)
focused = next((m for m in mons if m.get("focused")), mons[0])
w = int(focused.get("width") or 0)
h = int(focused.get("height") or 0)
if w > 0 and h > 0:
    print(f"{w}x{h}")
PY
}

cmd_status() {
  local mode usable effective replaces
  mode="$(read_mode)"
  usable=false
  if echo "$(caps_json)" | grep -q '"gamescopeUsable": true'; then
    usable=true
  fi
  effective="seat"
  if [[ "${mode}" == "session" && "${usable}" == "true" ]]; then
    effective="session"
  fi
  replaces=False
  [[ "${effective}" == "session" ]] && replaces=True
  python3 - <<PY
import json
print(json.dumps({
    "ok": True,
    "mode": "${mode}",
    "effective": "${effective}",
    "gamescopeUsable": "${usable}" == "true",
    "fact": "${FACT}",
    "replacesHyprland": ${replaces},
    "hint": "session mode: Gamescope owns the console session (applied at next posture flip/login); seat mode: Hyprland kiosk + supervised seats",
}))
PY
}

cmd_set_mode() {
  local m="${1:-}"
  case "${m}" in
    seat) ;;
    session|gamescope) m=session ;;
    *)
      echo '{"ok":false,"error":"mode must be seat|session"}'
      exit 1
      ;;
  esac
  mkdir -p "${FACT_DIR}"
  printf '%s\n' "${m}" >"${FACT}"
  python3 - <<PY
import json
print(json.dumps({"ok": True, "mode": "${m}", "fact": "${FACT}"}))
PY
}

cmd_resolve_flags() {
  # stdout: space-separated gamescope flags (no binary name) for the console
  # session compositor. Empty when effective mode is seat — callers must not
  # wrap the session in that case.
  local mode effective size
  mode="$(read_mode)"
  effective="seat"
  if [[ "${mode}" == "session" ]] && echo "$(caps_json)" | grep -q '"gamescopeUsable": true'; then
    effective="session"
  fi
  if [[ "${effective}" != "session" ]]; then
    exit 0
  fi
  size="$(monitor_size)"
  # Conservative flags — fullscreen; fixed size only when we could probe one.
  if [[ -n "${size}" ]]; then
    local w="${size%x*}"
    local h="${size#*x}"
    printf -- '-W %s -H %s -f\n' "${w}" "${h}"
  else
    printf -- '-f\n'
  fi
}

[[ $# -ge 1 ]] || usage
case "$1" in
  status) cmd_status ;;
  set-mode)
    shift
    [[ $# -ge 1 ]] || usage
    cmd_set_mode "$1"
    ;;
  resolve-flags) cmd_resolve_flags ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
