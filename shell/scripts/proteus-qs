#!/usr/bin/env bash
# proteus-qs — Quickshell chrome with crash backoff (files remain SoT).
# Usage:
#   proteus-qs <path-to-quickshell-config-dir>
#   proteus-qs --restart <path>   # kill prior wrapper+chrome for path, then start
# Hyprland: exec-once = PROTEUS_SURFACE=desktop …/proteus-qs …/shell
set -uo pipefail

RESTART=0
if [[ "${1:-}" == "--restart" ]]; then
  RESTART=1
  shift
fi

SHELL_PATH="${1:-}"
if [[ -z "${SHELL_PATH}" ]]; then
  echo "usage: $0 [--restart] <quickshell -p path>" >&2
  exit 2
fi
# Normalize for stable flock key + pkill patterns
SHELL_PATH="$(cd "${SHELL_PATH}" 2>/dev/null && pwd -P || echo "${SHELL_PATH}")"

if ! command -v quickshell >/dev/null 2>&1; then
  echo "proteus-qs: quickshell not found" >&2
  exit 127
fi

LOG="${XDG_RUNTIME_DIR:-/tmp}/proteus-qs.log"
BACKOFF=2
MAX_BACKOFF=30
HEALTHY_SECS=120

export QS_ICON_THEME="${QS_ICON_THEME:-Papirus-Dark}"
export PROTEUS_ROOT="${PROTEUS_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
export PROTEUS_SURFACE="${PROTEUS_SURFACE:-desktop}"
export PATH="/usr/local/bin:${PROTEUS_ROOT}/shell/scripts:${PATH}"
SELF="${PROTEUS_ROOT}/shell/scripts/proteus-qs"

log() {
  printf '%s proteus-qs: %s\n' "$(date -Iseconds 2>/dev/null || date)" "$*" >>"${LOG}" 2>/dev/null || true
}

# Kill chrome quickshell for this path only (not wallpaper / Settings).
reap_chrome() {
  pkill -f "quickshell -p ${SHELL_PATH}( |$)" 2>/dev/null || true
  sleep 0.2
}

kill_other_wrappers() {
  local my=$$
  local pid
  # Match wrappers targeting this shell path; skip this PID.
  while read -r pid; do
    [[ -z "${pid}" || "${pid}" == "${my}" ]] && continue
    kill "${pid}" 2>/dev/null || true
  done < <(pgrep -f "${SELF}( --restart)? ${SHELL_PATH}" 2>/dev/null || true)
  sleep 0.2
}

if [[ "${RESTART}" -eq 1 ]]; then
  log "restart requested for ${SHELL_PATH}"
  kill_other_wrappers
  reap_chrome
  sleep 0.3
  exec "${SELF}" "${SHELL_PATH}"
fi

# Single-instance: one wrapper per shell path (prevents doubled bar/dock).
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}"
LOCK_HASH="$(printf '%s' "${SHELL_PATH}" | sha256sum 2>/dev/null | awk '{print $1}' | cut -c1-16)"
LOCK="${LOCK_DIR}/proteus-qs-${LOCK_HASH:-shell}.lock"
exec 9>"${LOCK}"
if ! flock -n 9; then
  log "already running for ${SHELL_PATH}; exit (refusing double chrome)"
  exit 0
fi

trap 'exit 0' TERM INT HUP

# Clear orphans left by tips that started bare quickshell beside the wrapper.
reap_chrome

while true; do
  log "starting quickshell -p ${SHELL_PATH}"
  start_ts=$(date +%s 2>/dev/null || echo 0)
  # 9>&- : never leak the flock fd into quickshell (and its execDetached
  # children) — a surviving grandchild kept the lock held after a crash,
  # locking every future wrapper out ("refusing double chrome" forever).
  quickshell -p "${SHELL_PATH}" 9>&-
  ec=$?
  end_ts=$(date +%s 2>/dev/null || echo 0)
  ran=$((end_ts - start_ts))
  log "exited ${ec} after ${ran}s"
  if [[ "${ran}" -ge "${HEALTHY_SECS}" ]]; then
    BACKOFF=2
  fi
  sleep "${BACKOFF}"
  if [[ "${BACKOFF}" -lt "${MAX_BACKOFF}" ]]; then
    BACKOFF=$((BACKOFF * 2))
    if [[ "${BACKOFF}" -gt "${MAX_BACKOFF}" ]]; then
      BACKOFF=${MAX_BACKOFF}
    fi
  fi
  # A tip may have started a bare QS while we slept — reap before respawn.
  reap_chrome
done
