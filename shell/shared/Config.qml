  function formatAudioDeviceName(name) {
    if (!name || !String(name).length)
      return "Unknown"
    const n = String(name)
    if (n.indexOf("null") >= 0)
      return "Null (dummy)"
    if (n.indexOf(".monitor") >= 0)
      return "Monitor"
    const tail = n.split(".").pop() || n
    return tail.replace(/-/g, " ").replace(/\b\w/g, c => c.toUpperCase())
  }

