  function identifyMonitor(name) {
    if (!name || !String(name).length)
      return
    const n = String(name)
    identifyTarget = n
    identifyActive = false
    identifyActive = true
    identifyClearTimer.restart()
    Quickshell.execDetached({
      command: ["hyprctl", "dispatch", "focusmonitor", n]
    })
    Quickshell.execDetached({
      command: ["hyprctl", "notify", "1", "1800", "0", "Monitor: " + n]
    })
  }

